<?xml version="1.0"?>
<schema xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:Setup/Declaration/Schema/etc/schema.xsd">
    <table name="custom_order_status_log" resource="default" engine="innodb" comment="Order Status Log">
        <column name="id" xsi:type="int" nullable="false" identity="true" unsigned="true" comment="ID"/>
        <column name="order_id" xsi:type="int" nullable="false" comment="Order ID"/>
        <column name="old_status" xsi:type="varchar" length="32" nullable="false" comment="Old Status"/>
        <column name="new_status" xsi:type="varchar" length="32" nullable="false" comment="New Status"/>
        <column name="created_at" xsi:type="timestamp" nullable="false" default="CURRENT_TIMESTAMP" comment="Timestamp"/>
        <constraint xsi:type="primary" referenceId="PRIMARY">
            <column name="id"/>
        </constraint>
    </table>
</schema>
